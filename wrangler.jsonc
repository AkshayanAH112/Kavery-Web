{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kavery-sports-club",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // html_handling none: serve /offline.html as-is. The default redirects it to /offline, and a
  // service worker may not answer a navigation with a redirected response.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kavery-sports-club" }],
  // D1 — the whole database (created in the APAC region). Local dev and `npm run preview`
  // use a local SQLite file and ignore the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kavery-db",
      "database_id": "a157ac46-8a8d-4cde-9013-92ae1b959384",
      // Local development keeps its own database file under this id, so a developer's local data
      // is never tied to (or confused with) the live database above.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // R2 — every uploaded image and document (gallery, news, member photos, payment slips, crests).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kaverysc", "preview_bucket_name": "kavery-media" }],
  // The club's own address. Cloudflare creates the DNS records and the certificate itself;
  // the domain's nameservers must point at Cloudflare for it to answer.
  "routes": [
    { "pattern": "periyaneelavanaikaverysports.club", "custom_domain": true },
    { "pattern": "www.periyaneelavanaikaverysports.club", "custom_domain": true }
  ],
  // Keeps the workers.dev address alive as well (declaring routes would otherwise switch it off).
  "workers_dev": true,
  "vars": { "APP_URL": "https://periyaneelavanaikaverysports.club" },
  "observability": { "enabled": true }
}
