{
  "name": "kavery-sports-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply kavery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kavery-db --remote",
    "db:seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "vapid": "node scripts/vapid.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "db:demo": "wrangler d1 execute kavery-db --local --file scripts/demo.sql",
    "db:demo:clear": "wrangler d1 execute kavery-db --local --file scripts/demo-clear.sql",
    "db:demo:cricket": "node scripts/demo-cricket.mjs create",
    "db:demo:cricket:clear": "node scripts/demo-cricket.mjs remove",
    "db:demo:content": "node scripts/demo-content.mjs create",
    "db:demo:content:clear": "node scripts/demo-content.mjs remove",
    "db:demo:members": "node scripts/demo-members.mjs create",
    "db:demo:members:clear": "node scripts/demo-members.mjs remove"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
